{
	"name": "windui-monorepo",
	"version": "0.0.0",
	"description": "",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.23.0",
	"scripts": {
		"build": "pnpm -r --filter \"./packages/*\" run build",
		"play": "pnpm -C playground/vue-tailwind run dev",
		"playv4": "pnpm -C playground/vue-tailwindv4 run dev",
		"watch": "pnpm -r --parallel --filter \"./packages/*\" run build --watch",
		"dev": "pnpm build && pnpm play",
		"devv4": "pnpm build && pnpm playv4",
		"docs:dev": "pnpm -C docs run dev",
		"docs:build": "pnpm -C docs run build",
		"docs:preview": "pnpm -C docs run preview",
		"typecheck": "tsc --build --force",
		"lint": "eslint --cache .",
		"lint:fix": "pnpm lint --fix"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@eslint/js": "^10.0.1",
		"@tsconfig/node26": "^26.0.2",
		"@types/node": "26.6.6",
		"changelogithub": "^15.0.5",
		"eslint": "^10.15.0",
		"publint": "^0.3.25",
		"tsdown": "^0.23.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"vite": "^8.3.8"
	}
}
