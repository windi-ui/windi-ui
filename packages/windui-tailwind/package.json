{
	"name": "@windi-ui/tailwind",
	"version": "0.7.1",
	"license": "MIT",
	"author": "Waleed Khaled <https://github.com/Waleed-KH>",
	"description": "Modern, modular, and customizable UI component library",
	"keywords": [
		"ui",
		"component",
		"tailwindcss"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/windi-ui/windi-ui.git"
	},
	"bugs": {
		"url": "https://github.com/windi-ui/windi-ui/issues"
	},
	"type": "module",
	"scripts": {
		"build": "tsdown"
	},
	"module": "./dist/index.mjs",
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./config": {
			"import": "./dist/config.mjs",
			"require": "./dist/config.cjs"
		},
		"./v3": {
			"import": "./dist/v3.mjs",
			"require": "./dist/v3.cjs"
		},
		"./v4": {
			"import": "./dist/v4.mjs",
			"require": "./dist/v4.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@windi-ui/core": "workspace:*",
		"unconfig": "^7.5.0"
	},
	"peerDependencies": {
		"tailwindcss": ">=3.3.0"
	},
	"devDependencies": {
		"tailwindcss": "^3.4.19"
	}
}
