{
	"name": "@windi-ui/core",
	"version": "0.8.0-beta.1",
	"license": "MIT",
	"author": "Waleed Khaled <https://github.com/Waleed-KH>",
	"description": "Modern, modular, and customizable UI component library",
	"keywords": [
		"ui",
		"component"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/windi-ui/windi-ui.git"
	},
	"bugs": {
		"url": "https://github.com/windi-ui/windi-ui/issues"
	},
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"prepack": "node -e \"fs.copyFileSync('../../README.md', 'README.md')\""
	},
	"module": "./dist/index.mjs",
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./components": {
			"import": "./dist/components.mjs",
			"require": "./dist/components.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"csstype": "^3.2.4"
	}
}
