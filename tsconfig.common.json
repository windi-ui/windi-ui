{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2020",
		"lib": ["ESNext"],
		"types": ["node"],
		"useDefineForClassFields": true,
		"skipLibCheck": true,

		/* Bundler mode */
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,

		/* Linting */
		"strict": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitThis": true,

		"composite": true,
		"declaration": true,
		"declarationMap": true,

		/* Typecheck only: tsdown writes dist */
		"emitDeclarationOnly": true,
		"outDir": "${configDir}/node_modules/.tsc"
	},
	"exclude": [
		"**/dist",
		"**/node_modules"
	]
}
